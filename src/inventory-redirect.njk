<section class="source-band signal-chain-dossier" aria-labelledby="inventory-jurisdiction-heading">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label fi-caption-box"><span class="fi-prompt-marker" aria-hidden="true">&gt;</span>JURISDICTION</p>
      <h2 id="inventory-jurisdiction-heading">ONE UNIT. ONE RECORD. EVERY MOVEMENT WITNESSED.</h2>
    </div>
    <div class="larchive-spec-grid">
      <article>
        <h3>IDENTITY</h3>
        <p>Non-reused item identifier, object class, condition, and source profile.</p>
      </article>
      <article>
        <h3>CUSTODY</h3>
        <p>Local location, intake state, movement history, and present responsibility.</p>
      </article>
      <article>
        <h3>WORK</h3>
        <p>Inspection, cleaning, refurbishment, photography, and packing checks.</p>
      </article>
      <article>
        <h3>DISPOSITION</h3>
        <p>Listing, sale, trade, shipment, archive, or an explicitly unresolved state.</p>
      </article>
      <article>
        <h3>RESULT</h3>
        <p>Per-item basis, fees, adjustments, and recognized result after clearance.</p>
      </article>
      <article>
        <h3>PROMOTION</h3>
        <p>Selected public-safe object evidence may enter <a href="/archive/inventory/">L'ARCHIVE's inventory shelf</a>; the operating register does not.</p>
      </article>
    </div>
  </div>
</section>

<section class="evidence-band signal-chain-dossier" aria-labelledby="inventory-sequence-heading">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label fi-caption-box"><span class="fi-prompt-marker" aria-hidden="true">&gt;</span>OPERATING SEQUENCE</p>
      <h2 id="inventory-sequence-heading">A LISTING IS NOT A SALE. A SALE IS NOT A SHIPMENT.</h2>
    </div>
    <ol class="progression-list">
      <li class="complete">
        <span>01</span>
        <h3>INTAKE</h3>
        <p>Assign the unit record before cleaning, sorting, or interpretation erases its received state.</p>
      </li>
      <li class="complete">
        <span>02</span>
        <h3>PREPARE</h3>
        <p>Inspect, clean, photograph, and grade against the applicable object profile.</p>
      </li>
      <li class="complete">
        <span>03</span>
        <h3>DISPOSE</h3>
        <p>Record publication, sale, trade, packing, and carrier handoff as distinct events.</p>
      </li>
      <li class="active">
        <span>04</span>
        <h3>RECONCILE</h3>
        <p>Recognize per-item result only when value, costs, fees, and adjustments are evidenced.</p>
      </li>
    </ol>
  </div>
</section>

