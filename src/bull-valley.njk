    :root {
      color-scheme: dark;
      --fi-bg: #000000;
      --fi-surface: #020617;
      --fi-surface-82: rgb(2 6 23 / 0.82);
      --fi-cyan: #22d3ee;
      --fi-green: #4ade80;
      --fi-amber: #fbbf24;
      --fi-gold: #f59e0b;
      --fi-magenta: #e879f9;
      --fi-maroon: #7f1d1d;
      --fi-slate: #94a3b8;
      --fi-paper-light: #f7f4ef;
      --fi-black-shadow: rgb(0 0 0 / 0.58);
      --gs-mono: 'Space Mono', ui-monospace, monospace;
    }
    html,
    body {
      height: 100%;
      margin: 0;
      background: var(--fi-bg);
      color: var(--fi-paper-light);
      font-family: var(--gs-mono);
      overflow: hidden;
    }
    #gs-fallback {
      padding: 2rem;
      font-size: 0.8rem;
      line-height: 1.7;
    }
    #gs-fallback a {
      color: var(--fi-cyan);
    }
  </style>
  <link rel="stylesheet" href="/bull-valley/assets/gs.css?v={{ site.assetVersion }}">
