---
permalink: /zoot/
eleventyExcludeFromCollections: true
title: ZOOT
description: A non-linear instrument for reading the Forgotten Industries archive.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>ZOOT &mdash; {{ site.name }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ site.domainUrl }}/zoot/">
  {% include "social-meta.njk" %}
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
  <link rel="icon" href="/assets/favicon/favicon.ico">
  <style>
    /* Space Mono only. This page does not load archive.css, so the two weights
       it uses are declared here against the self-hosted files. */
    @font-face {
      font-family: 'Space Mono';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/assets/fonts/space-mono-400-normal-latin.woff2') format('woff2');
    }

    @font-face {
      font-family: 'Space Mono';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('/assets/fonts/space-mono-700-normal-latin.woff2') format('woff2');
    }

    /* Tokens sourced from src/css/archive.css:4-25 — that file is the source of
       truth; this page deliberately does not load the shared stylesheet. */
    :root {
      color-scheme: dark;
      --fi-bg: #000000;
      --fi-surface: #020617;
      --fi-cyan: #22d3ee;
      --fi-green: #4ade80;
      --fi-amber: #fbbf24;
      --fi-gold: #f59e0b;
      --fi-magenta: #e879f9;
      --fi-paper-light: #f7f4ef;
      --fi-white-rgb: 255 255 255;
      --zoot-mono: 'Space Mono', ui-monospace, monospace;
    }
    html,
    body {
      height: 100%;
      margin: 0;
      background: var(--fi-bg);
      color: var(--fi-paper-light);
      font-family: var(--zoot-mono);
      overflow: hidden;
    }
    #zoot-canvas {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      display: block;
      touch-action: none;
      cursor: crosshair;
    }
    .zoot-visually-hidden,
    .zoot-access-link:not(:focus) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    .zoot-access-link:focus {
      position: fixed;
      top: max(1rem, env(safe-area-inset-top));
      left: max(1rem, env(safe-area-inset-left));
      z-index: 4;
      padding: 0.75rem 1rem;
      border: 1px solid var(--fi-cyan);
      background: var(--fi-surface);
      color: var(--fi-paper-light);
    }
    /* Bottom chrome: the exit mark and sound toggle sit in one fixed bar. The
       bar ignores pointer events (canvas keeps receiving stirs); only its
       links opt back in. */
    #zoot-chrome {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 3;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 0.35rem 1rem;
      padding: 0.5rem max(1rem, env(safe-area-inset-right))
        max(1rem, env(safe-area-inset-bottom))
        max(1.25rem, env(safe-area-inset-left));
      pointer-events: none;
    }
    /* The exit link and the sound toggle share one control cluster on the left
       of the chrome; the toggle reuses the exit link's muted-until-hover look. */
    #zoot-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 0 0.75rem;
      pointer-events: none;
    }
    #zoot-exit,
    #zoot-audio-toggle {
      padding: 0.5rem 0.75rem 0.5rem 0;
      color: var(--fi-paper-light);
      font-family: inherit;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      text-decoration: none;
      white-space: nowrap;
      opacity: 0.3;
      transition: opacity 160ms ease;
      pointer-events: auto;
    }
    #zoot-audio-toggle {
      border: 0;
      background: none;
      text-transform: uppercase;
      cursor: pointer;
    }
    #zoot-exit:hover,
    #zoot-exit:focus-visible,
    #zoot-audio-toggle:hover,
    #zoot-audio-toggle:focus-visible {
      opacity: 0.85;
      outline: none;
    }
    #zoot-focus {
      position: fixed;
      max-width: min(26rem, calc(100vw - 2rem));
      padding: 0.9rem 1rem;
      background: rgb(2 6 23 / 0.92);
      border: 1px solid rgb(var(--fi-white-rgb) / 0.18);
      font-size: 0.8rem;
      line-height: 1.5;
      z-index: 2;
    }
    #zoot-focus .zoot-focus-kind {
      display: block;
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      opacity: 0.6;
      margin-bottom: 0.35rem;
    }
    #zoot-focus .zoot-focus-title {
      display: block;
      margin-bottom: 0.6rem;
    }
    #zoot-focus a {
      display: inline-block;
      min-height: 44px;
      line-height: 44px;
      padding: 0 0.25rem;
      color: var(--fi-cyan);
      letter-spacing: 0.12em;
      text-decoration: none;
    }
    #zoot-focus a:hover,
    #zoot-focus a:focus-visible {
      text-decoration: underline;
    }
    #zoot-fallback {
      position: fixed;
      inset: 0;
      overflow-y: auto;
      padding: clamp(1.5rem, 6vw, 4rem);
      z-index: 1;
    }
    .zoot-panel-heading {
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      opacity: 0.7;
      margin: 0 0 1.5rem;
      max-width: 34rem;
      line-height: 1.7;
    }
    .zoot-panel-list {
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 34rem;
    }
    .zoot-panel-list li {
      margin-bottom: 0.9rem;
      font-size: 0.8rem;
      line-height: 1.55;
    }
    .zoot-panel-list a {
      color: var(--fi-cyan);
      text-decoration: none;
    }
    .zoot-panel-list a:hover,
    .zoot-panel-list a:focus-visible {
      text-decoration: underline;
    }
    .zoot-panel-list .zoot-kind {
      display: block;
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      opacity: 0.5;
    }
    noscript .zoot-panel-heading {
      position: fixed;
      top: clamp(1.5rem, 6vw, 4rem);
      left: clamp(1.5rem, 6vw, 4rem);
    }
    noscript a {
      color: var(--fi-cyan);
    }
    /* Ignition modal: the entry gate. Ships hidden and is revealed by JS
       (src/assets/js/zoot/intro.js), so no-JS visitors fall through to the
       <noscript> panel instead of a dead overlay. */
    #zoot-intro {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: clamp(2rem, 7vh, 4.5rem);
      padding: 2rem;
      background: var(--fi-bg);
      text-align: center;
    }
    #zoot-intro[hidden] {
      display: none;
    }
    #zoot-intro-title {
      margin: 0;
      font-family: var(--zoot-mono);
      font-weight: 700;
      font-size: clamp(4rem, 24vw, 15rem);
      line-height: 0.85;
      letter-spacing: 0.06em;
      color: var(--fi-paper-light);
    }
    #zoot-intro-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 1.5rem;
    }
    .zoot-intro-btn {
      min-height: 44px;
      padding: 0.9rem 1.6rem;
      font-family: var(--zoot-mono);
      font-size: 0.8rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--fi-paper-light);
      background: var(--fi-surface);
      border: 1px solid var(--fi-cyan);
      cursor: pointer;
      transition:
        background 160ms ease,
        color 160ms ease;
    }
    .zoot-intro-btn--primary {
      color: var(--fi-bg);
      background: var(--fi-cyan);
    }
    .zoot-intro-btn:hover {
      color: var(--fi-bg);
      background: var(--fi-cyan);
    }
    .zoot-intro-btn--primary:hover {
      background: var(--fi-paper-light);
      border-color: var(--fi-paper-light);
    }
    .zoot-intro-btn:focus-visible {
      outline: 3px solid var(--fi-cyan);
      outline-offset: 3px;
    }
  </style>
</head>
<body>
  <main>
    <h1 class="zoot-visually-hidden">ZOOT archive instrument</h1>
    <a class="zoot-access-link" href="/l-archive/">Open the accessible archive index</a>
    {% if zootMixtape %}
    <div id="zoot-intro" role="dialog" aria-modal="true" aria-labelledby="zoot-intro-title" hidden>
      <h2 id="zoot-intro-title">ZOOT</h2>
      <div id="zoot-intro-actions">
        <button type="button" class="zoot-intro-btn" data-zoot-sound="off">Silent Running</button>
        <button type="button" class="zoot-intro-btn zoot-intro-btn--primary" data-zoot-sound="on">Extra Crispy</button>
      </div>
    </div>
    {% endif %}
    <canvas id="zoot-canvas" aria-hidden="true"></canvas>
    <div id="zoot-focus" hidden></div>
    <section id="zoot-fallback" hidden aria-label="Archive records"></section>
    <div id="zoot-chrome">
      <div id="zoot-controls">
        <a id="zoot-exit" href="/">FORGOTTEN INDUSTRIES /</a>
        {% if zootMixtape %}
        <button id="zoot-audio-toggle" type="button" aria-pressed="true">Sound On</button>
        {% endif %}
      </div>
    </div>
    <noscript>
      <p class="zoot-panel-heading">
        ATLAS REPORT &mdash; this instrument requires script execution. The slick
        will not resolve. The records remain:
        <a href="/l-archive/">L'ARCHIVE</a>
      </p>
    </noscript>
  </main>
  <script type="application/json" id="zoot-photos">{{ zootPhotos | dump | safe }}</script>
  {% if zootMixtape %}
  <script type="application/json" id="zoot-audio">{{ zootMixtape | dump | safe }}</script>
  {% endif %}
  <script type="module" src="/assets/js/zoot/main.js?v={{ site.assetVersion }}"></script>
</body>
</html>
