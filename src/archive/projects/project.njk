---
layout: base.njk
pagination:
  data: archive.projects
  size: 1
  alias: project
permalink: "/archive/projects/{{ project.slug | archiveSlug }}/"
eleventyComputed:
  title: "L'Archive / Dossier / {{ project.title }}"
  description: "{{ project.summary }}"
eleventyExcludeFromCollections: true
---
<section class="masthead">
  <div class="section-inner">
    <p class="section-label">{% if project.division %}{{ project.division }} / {% endif %}Dossier Record / {{ project.id }}</p>
    <h1>{{ project.title }}</h1>
    <p class="tagline">{{ project.summary }}</p>
    {% if project.doctrine %}
    <p class="fi-caption-box"><span class="fi-prompt-marker">&gt;</span> {{ project.doctrine }}</p>
    {% endif %}
    {% if project.flight_call %}
    <p class="entry-note">{{ project.flight_call }}</p>
    {% endif %}
    {% if project.capability and project.capability_url %}
    <p class="action-row"><a href="{{ project.capability_url }}">Open {{ project.capability }}, the archival capability this dossier exercises</a></p>
    {% endif %}
  </div>
</section>

<section class="evidence-band">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label">{{ project.category }}</p>
      <h2>Status and continuity.</h2>
    </div>

    <ul class="link-list">
      <li>
        <h3>Status</h3>
        <p>{{ project.status }}</p>
      </li>
      {% if project.started %}
      <li>
        <h3>Started</h3>
        <p>{{ project.started }}</p>
      </li>
      {% endif %}
      {% if project.revived %}
      <li>
        <h3>Revived</h3>
        <p>{{ project.revived }}</p>
      </li>
      {% endif %}
      {% if project.working_title %}
      <li>
        <h3>Working Title</h3>
        <p>{{ project.working_title }}</p>
      </li>
      {% endif %}
      {% if project.registry %}
      <li>
        <h3>Registry</h3>
        <p>{{ project.registry }}{% if project.registry_predecessor %}, evolved from {{ project.registry_predecessor }}{% endif %}</p>
      </li>
      {% endif %}
      {% if project.airframe_lineage %}
      <li>
        <h3>Airframe Lineage</h3>
        <p>{{ project.airframe_lineage }}</p>
      </li>
      {% endif %}
      {% if project.target_instrument %}
      <li>
        <h3>Target Instrument</h3>
        <p>{{ project.target_instrument }} / stated intent, not a flight record</p>
      </li>
      {% endif %}
    </ul>
  </div>
</section>

{% set projectObjects = archive.inventory | whereAssociatedProject(project.id) %}
{% set projectLogs = archive.fieldLogs | whereAssociatedProject(project.id) %}

<section class="source-band">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label">{{ projectObjects.length | countLabel("object", "objects") }}</p>
      <h2>Object/component records.</h2>
    </div>

    <ul class="link-list archive-record-list">
      {% for item in projectObjects %}
      <li>
        <p class="entry-note">{{ item.id }} / {{ item.category }} / {{ item.status }}</p>
        <h3><a href="{{ item | archiveObjectUrl }}">{{ item.name }}</a></h3>
        <p>{{ item.condition }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% if projectLogs.length %}
<section class="evidence-band">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label">{{ projectLogs.length | countLabel("log", "logs") }}</p>
      <h2>Field evidence.</h2>
    </div>

    <ul class="link-list archive-record-list">
      {% for log in projectLogs | fieldLogsNewest %}
      <li>
        <p class="entry-note">{{ log.id }} / {{ log.date }} / {{ log.category }}</p>
        <h3><a href="/field-logs/{{ log.slug }}/">{{ log.title }}</a></h3>
        <p>{{ log.object }}. {{ log.status }}.</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if project.themes and project.themes.length %}
<section class="source-band">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label">Tags</p>
      <h2>Dossier taxonomy.</h2>
    </div>

    <ul class="link-list archive-record-list">
      {% for theme in project.themes %}
      <li>
        <h3><a href="/archive/tags/{{ theme | archiveSlug }}/">{{ theme }}</a></h3>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
