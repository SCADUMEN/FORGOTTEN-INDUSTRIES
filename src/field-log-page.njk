---
layout: base.njk
pagination:
  data: archive.fieldLogs
  size: 1
  alias: log
permalink: /field-logs/{{ log.slug }}/
eleventyComputed:
  title: "{{ log.title }}"
  description: "{{ log.summary or log.title }}"
  canonical: "{{ site.domainUrl }}/field-logs/{{ log.slug }}/"
---
{% set project = archive.projects | findById(log.associated_project) %}
<section class="masthead field-log-atlas-shell field-log-atlas-masthead">
  <div class="section-inner">
    <p class="section-label fi-caption-box"><span class="fi-prompt-marker">&gt;</span>ATLAS / {{ log.id }}</p>
    <h1>{{ log.title }}</h1>
    <p class="tagline">{{ log.summary or "End-of-day ATLAS operational summary." }}</p>
  </div>
</section>

<section class="source-band field-log-atlas-shell field-log-atlas-panel" aria-labelledby="field-log-record-heading">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label fi-caption-box"><span class="fi-prompt-marker">&gt;</span>Source record</p>
      <h2 id="field-log-record-heading">SOURCE RECORD // READY</h2>
    </div>

    <dl class="record-meta-grid record-meta-grid-atlas">
      <div>
        <dt>Date</dt>
        <dd><time datetime="{{ log.date }}">{{ log.timestamp or log.date }}</time></dd>
      </div>
      <div>
        <dt>ID</dt>
        <dd>{{ log.id }}</dd>
      </div>
      <div>
        <dt>Type</dt>
        <dd>{{ log.category }}</dd>
      </div>
      {% if log.object %}
      <div>
        <dt>Object</dt>
        <dd>{{ log.object }}</dd>
      </div>
      {% endif %}
      {% if log.system %}
      <div>
        <dt>System</dt>
        <dd>{{ log.system }}</dd>
      </div>
      {% endif %}
      {% if log.condition %}
      <div>
        <dt>Condition</dt>
        <dd>{{ log.condition }}</dd>
      </div>
      {% endif %}
      {% if log.status %}
      <div>
        <dt>Status</dt>
        <dd>{{ log.status }}</dd>
      </div>
      {% endif %}
      {% if project %}
      <div>
        <dt>Associated dossier</dt>
        <dd><a href="{{ project | archiveProjectUrl }}">{{ project.title }}</a> / {{ project.id }}</dd>
      </div>
      {% elif log.associated_project %}
      <div>
        <dt>Associated dossier</dt>
        <dd>{{ log.associated_project }}</dd>
      </div>
      {% endif %}
    </dl>
  </div>
</section>

<section class="evidence-band field-log-atlas-shell field-log-atlas-panel" aria-labelledby="field-log-body-heading">
  <div class="section-inner">
    <div class="field-notes-heading">
      <p class="section-label fi-caption-box"><span class="fi-prompt-marker">&gt;</span>ATLAS Field Dossier</p>
      <h2 id="field-log-body-heading">SYSTEM OUTPUT // FIELD INSTRUMENT</h2>
    </div>

    {% if log.tags and log.tags.length %}
    <p class="stamp-row" aria-label="Field log tags">
      {% for tag in log.tags %}
      <span class="stamp stamp-muted">{{ tag }}</span>
      {% endfor %}
    </p>
    {% endif %}

    <article class="field-log-body field-log-body-atlas">
      {% for section in log.sections %}
      <section>
        <h3><span class="fi-prompt-marker">&gt;</span>{{ section.heading }}</h3>
        <p>{{ section.body }}</p>
      </section>
      {% endfor %}
    </article>

    <aside class="field-log-atlas-provenance" role="note" aria-label="ATLAS provenance">
      <p><span class="fi-prompt-marker">&gt;</span>PROVENANCE // HUMAN JUDGMENT // MACHINE COLLABORATION // OPERATOR VERIFIED</p>
    </aside>
  </div>
</section>

<section class="source-band field-log-atlas-shell field-log-atlas-panel" aria-labelledby="field-log-source-heading">
  <div class="section-inner band-grid">
    <div>
      <p class="section-label fi-caption-box"><span class="fi-prompt-marker">&gt;</span>Record metadata</p>
      <h2 id="field-log-source-heading">INSPECTABLE SOURCE // CANONICAL</h2>
    </div>

    <div class="callout field-log-atlas-callout">
      <h3>{{ log.signature }}</h3>
      <p>Canonical source: <a href="/src/data/field-logs.yml">src/data/field-logs.yml</a></p>
      {% if log.source_path %}
      <p>Draft/source note: <a href="/{{ log.source_path | replace('src/', '') }}">{{ log.source_path }}</a></p>
      {% endif %}
      <p>Route: <code>/field-logs/{{ log.slug }}/</code></p>
      <p class="action-row"><a href="/atlas/">Return to ATLAS Reports</a> / <a href="/field-logs/">Open Field Logs</a></p>
    </div>
  </div>
</section>
