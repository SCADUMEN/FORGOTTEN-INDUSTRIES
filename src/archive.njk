        <a class="stat" href="/archive/taxonomy/">
          <span class="stat-label">{{ taxonomy.allTerms | pluralLabel("Taxonomy term", "Taxonomy terms") }} <span class="stat-count">({{ taxonomy.allTerms | count }})</span></span>
        </a>
        <a class="stat" href="/hang-on-to-each-other/">
          <span class="stat-label">{{ 2 | pluralLabel("Manuel", "Manuels") }} <span class="stat-count">(2)</span></span>
        </a>
        <a class="stat" href="/en-direct/">
          <span class="stat-label">{{ fieldnotes | pluralLabel("En Direct record", "En Direct records") }} <span class="stat-count">({{ fieldnotes | count }})</span></span>
        </a>
        <a class="stat" href="/archive/social-evidence/">
          <span class="stat-label">{{ archive.socialPosts | pluralLabel("Recovered social record", "Recovered social records") }} <span class="stat-count">({{ archive.socialPosts | count }})</span></span>
        </a>
        <a class="stat" href="/archive/posts/">
          <span class="stat-label">{{ collections.posts | pluralLabel("Written record", "Written records") }} <span class="stat-count">({{ collections.posts | count }})</span></span>
        </a>
        <a class="stat" href="/archive/field-logs/">
          <span class="stat-label">{{ archive.fieldLogs | pluralLabel("ATLAS report", "ATLAS reports") }} <span class="stat-count">({{ archive.fieldLogs | count }})</span></span>
        </a>
        <a class="stat stat-wide" href="/archive/objects/">
          <span class="stat-label">{{ archive.inventory | pluralLabel("Object catalogued", "Objects catalogued") }} <span class="stat-count">({{ archive.inventory | count }})</span></span>
          <span class="stat-adjustment">Live canonical inventory</span>
        </a>
        <a class="stat stat-wide" href="{{ site.githubUrl }}/commits/main">
          <span class="stat-label">{{ site.sourceStats.commits | pluralLabel("Git commit", "Git commits") }} <span class="stat-count">({{ site.sourceStats.commits }})</span></span>
          <span class="stat-adjustment" title="Change since {{ site.sourceStats.deltaSince }}">
            {{ site.sourceStats.commitDeltaLabel }}
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
