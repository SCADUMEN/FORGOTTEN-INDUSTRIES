---
layout: base.njk
title: Le Blog
description: "Operator dispatches and non-doctrine signal posts from Forgotten Industries."
permalink: /blog/index.html
eleventyExcludeFromCollections: true
---
{% set posts = collections.posts | signalPosts %}

<section class="masthead">
  <div class="section-inner">
    <p class="section-label">Le Signal / Le Blog</p>
    <h1>Le Blog</h1>
    <p class="tagline">{{ description }}</p>
  </div>
</section>

<section class="evidence-band">
  <div class="section-inner">
    <div class="signal-map">
      <p class="entry-note">
        Live transmission layer. Formal doctrines and system reports are filed under
        <a href="/oeuvre/">L'Œuvre</a>.
      </p>

      <section class="signal-section" aria-labelledby="blog-entries-heading">
        <p class="section-label">{{ posts | countLabel("entry", "entries") }}</p>
        <h2 id="blog-entries-heading">Blog dispatches, newest first.</h2>
        {% if posts.length %}
        <ol class="signal-entry-list" aria-label="Blog dispatches">
          {% for post in posts | reverse %}
          <li>
            <header>
              <span>{% if post.data.entry %}Entry {{ post.data.entry }}{% else %}Entry{% endif %}</span>
              <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
            </header>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p class="entry-note">
              {% if post.data.type %}{{ post.data.type }}{% else %}Signal dispatch{% endif %}
              {% if post.data.category %}/ {{ post.data.category }}{% endif %}
            </p>
            {% if post.data.description %}
            <p>{{ post.data.description }}</p>
            {% endif %}
          </li>
          {% endfor %}
        </ol>
        {% else %}
        <div class="callout">
          <h3>Signal Pending</h3>
          <p>No operator blog dispatches are published in this build.</p>
        </div>
        {% endif %}
      </section>
    </div>
  </div>
</section>
