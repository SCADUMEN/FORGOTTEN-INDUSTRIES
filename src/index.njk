---
layout: base.njk
title: Forgotten Industries
description: An archive and evidence-based memoir.
canonical: https://forgotten-industries.net/
page_class: homepage-landing
---
<section class="masthead homepage-masthead" aria-labelledby="home-title">
  <div class="section-inner masthead-grid">
    <div>
      <h1 id="home-title" class="sr-only">{{ site.name }}</h1>
      <p class="tagline">{{ site.tagline }}</p>
      <p class="homepage-doctrine">
        <span class="homepage-doctrine-line">
          <span class="homepage-doctrine-prompt" aria-hidden="true">&gt;</span>
          <span class="homepage-doctrine-text">A THING DOCUMENTED IS A THING NOT YET LOST.</span>
        </span>
      </p>
    </div>
    <div class="hero-mark" role="img" aria-label="Forgotten Industries logo, EST MMXIV"></div>
  </div>
</section>

<section class="homepage-docent" aria-labelledby="homepage-docent-heading">
  <div class="section-inner homepage-docent-panel">
    <div class="atlas-docent-portrait homepage-docent-portrait">
      <img src="/assets/atlas/atlas-archive-docent-cell-01.webp" width="192" height="208" alt="Atlas, the Archive Docent, a white Shiba archivist-engineer." loading="lazy" decoding="async">
    </div>
    <div class="homepage-docent-copy">
      <div>
        <p class="section-label">Archive orientation / ATLAS-UI-001</p>
        <h2 id="homepage-docent-heading">Atlas, the Archive Docent.</h2>
        <p class="homepage-docent-orientation">First time here? Choose a route below: L'Archive for evidence, L'Œuvre for dossiers and doctrine, Le Signal for field transmissions, or À Propos for the maker and method.</p>
      </div>
      <p class="action-row homepage-docent-action"><a href="/projects/atlas/">Open the ATLAS dossier <span aria-hidden="true">&gt;</span></a></p>
    </div>
  </div>
</section>

{% set primaryCards = [
  { href: "/l-archive/", title: "L'Archive", mark: "The Archive", terms: ["Object records", "Inventory", "Provenance", "Evidence"] },
  { href: "/oeuvre/", title: "L'Œuvre", mark: "The Work", terms: ["Dossiers", "Manuscripts", "Reports", "Doctrine"] },
  { href: "/signal/", title: "Le Signal", mark: "The Signal", terms: ["Blog", "En direct", "Voice", "Live input"] },
  { href: "/apropos/", title: "À Propos", mark: "About", terms: ["Maker plate", "Method", "Provenance", "Contact"] }
] %}
<section class="primary-finding-aid" aria-label="Primary archive sections">
  <div class="section-inner primary-card-grid">
    {%- for card in primaryCards %}
    <a class="primary-section-card" href="{{ card.href }}">
      <div class="primary-card-plate">
        <div class="primary-card-title-unit">
          <h2>{{ card.title | safe }}</h2>
          <strong class="primary-card-mark">&gt; {{ card.mark }}</strong>
        </div>
      </div>
      <span class="primary-card-scan" aria-hidden="true">
        <span class="primary-card-scan-track">
          <span class="primary-card-scan-segment">{{ card.terms | join(" <span>//</span> ") | safe }}</span>
          <span class="primary-card-scan-segment">{{ card.terms | join(" <span>//</span> ") | safe }}</span>
        </span>
      </span>
    </a>
    {%- endfor %}
  </div>
</section>
