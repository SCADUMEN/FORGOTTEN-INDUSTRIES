# Prevent temporary Workers preview and version URLs from becoming a second
# indexed origin. The production custom domain remains indexable.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Cloudflare Workers Assets serves everything as `max-age=0, must-revalidate`
# unless told otherwise, so every repeat visit re-validates every asset. The
# rules below are split by how a URL changes when its bytes change.

# Stylesheets are requested with a `?v=<commit>` cache buster, so a new build
# is a new URL and the cached copy can never go stale.
/css/*
  Cache-Control: public, max-age=31536000, immutable

# Media paths carry no version marker, so they are cached for a month rather
# than a year: long enough to stop the revalidation traffic, short enough that
# a re-encoded photograph or sprite propagates without a rename.
/assets/*
  Cache-Control: public, max-age=2592000

/*
  # Honour the declared Content-Type instead of sniffing it.
  X-Content-Type-Options: nosniff
  # Send the full URL same-origin, bare origin cross-origin, nothing to HTTP.
  Referrer-Policy: strict-origin-when-cross-origin
  # The archive is never framed by another site.
  X-Frame-Options: SAMEORIGIN
  # No page here asks for hardware or location.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  # HTTPS only. Deliberately without includeSubDomains or preload, so the
  # commitment stays scoped to this host and stays reversible.
  Strict-Transport-Security: max-age=31536000
