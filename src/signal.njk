---
layout: base.njk
title: Le Signal
description: "The Forgotten Industries transmission layer: blog dispatches, live feed records, and voice field journals."
permalink: /signal/index.html
eleventyExcludeFromCollections: true
---
{% set signalPosts = collections.posts | signalPosts %}
<section class="section-landing-hero">
  <div class="section-inner">
    <div class="spine-hero-title-block">
      <h1>Le Signal</h1>
      <p class="spine-hero-meta fi-caption-box"><span class="fi-prompt-marker">&gt;</span> Incoming transmissions.</p>
    </div>
  </div>
</section>

<section class="signal-ticker-band" aria-labelledby="signal-ticker-heading">
  <div class="section-inner">
    <div class="signal-ticker-header">
      <h2 id="signal-ticker-heading" class="sr-only">Recent signal activity</h2>
      <div class="signal-ticker-plate" aria-hidden="true">
        <p><span>/ / / / /</span> EN DIRECT <span>/ / / / /</span></p>
        <span class="fi-caption-box"><span class="fi-prompt-marker">&gt;</span> Live Feed / {{ fieldnotes | count }} posts</span>
      </div>
    </div>
    <div class="signal-ticker" role="list" aria-label="Recent signal activity">
      {% if fieldnotes.length %}
      {% for note in fieldnotes %}
      {% if loop.index <= 4 %}
      <a class="signal-ticker-item" role="listitem" href="{{ note.url }}" data-track="outbound-field-note">
        <span>En Direct / {{ note.createdAt | readableDate }}</span>
        <strong>{{ note.text | escape }}</strong>
      </a>
      {% endif %}
      {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<section class="signal-source-band" aria-labelledby="signal-directory-heading">
  <div class="section-inner">
    <h2 id="signal-directory-heading" class="sr-only">Signal sources</h2>
    <div class="directory-grid plate-card-grid signal-directory-grid">
      <a href="/blog/">
        <h3 class="signal-card-title">
          <span>LE BLOG</span>
          <span class="fi-caption-box"><span class="fi-prompt-marker">&gt;</span> BLOG ({{ signalPosts | count }})</span>
        </h3>
      </a>
      <a href="/en-direct/">
        <h3 class="signal-card-title">
          <span>EN DIRECT</span>
          <span class="fi-caption-box"><span class="fi-prompt-marker">&gt;</span> LIVE FEED ({{ fieldnotes | count }})</span>
        </h3>
      </a>
      <a href="/field-logs/">
        <h3 class="signal-card-title">
          <span>LES DÉPOSITIONS</span>
          <span class="fi-caption-box"><span class="fi-prompt-marker">&gt;</span> OM-882 AUDIO FIELD JOURNAL ({{ archive.voiceLogs | count }})</span>
        </h3>
      </a>
    </div>
  </div>
</section>
