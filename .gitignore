# Local runtimes, model weights, scratch logs, and recovery work never enter
# the public archive.
/work/

# CONTINUANCE generated data indexes (fetched/normalized at build time by
# scripts/build_continuance_index.cjs) and dev-only CSS copy. continuance/dist
# is covered by dist/.
/continuance/public/data/
/continuance/public/css/

# Local raw intake payloads. Promote curated derivatives into src/ or docs/
# before committing.
/intake/L-Archive/*
!/intake/L-Archive/README.md
/intake/SLUSH/*
/intake/fi-voice-split.html _ Claude.html
/intake/fi-voice-split.html _ Claude_files/
/intake/fi-claude-CV-001.txt
/intake/the-yellow-crowned-night-heron.md
/intake/yellow-crowned-night-heron_provenance.md
/intake/cursed-boochmonster.md
/intake/_manifests/
/intake/_previews/
/intake/_transcripts/
/intake/LE-BOX-*/
/intake/SECURITY-GATEWAY/
/intake/RELOCATION-2026/
/intake/STORAGE-MAP/
/intake/social/
# Private marketplace receipts, order identifiers, and acquisition ledgers.
/intake/marketplace/
# Media anywhere under intake/ stays local. These patterns are recursive (**) so
# nested folders such as intake/Splunking/ are covered too — a flat /intake/*.EXT
# rule only matches the top level and let geotagged photos slip into history.
/intake/**/*.HEIC
/intake/**/*.heic
/intake/**/*.HEIF
/intake/**/*.heif
/intake/**/*.JPG
/intake/**/*.jpg
/intake/**/*.JPEG
/intake/**/*.jpeg
/intake/**/*.PNG
/intake/**/*.png
/intake/**/*.TIF
/intake/**/*.tif
/intake/**/*.TIFF
/intake/**/*.tiff
/intake/**/*.WEBP
/intake/**/*.webp
/intake/**/*.MOV
/intake/**/*.mov
/intake/**/*.MP4
/intake/**/*.mp4
/intake/**/*.MP3
/intake/**/*.mp3
/intake/**/*.WAV
/intake/**/*.wav
/intake/**/*.M4A
/intake/**/*.m4a
/intake/**/*.AIFF
/intake/**/*.aiff
/intake/**/*.AIF
/intake/**/*.aif
/intake/**/*.zip

# Cloudflare local state and credentials never enter the archive.
.wrangler/
.dev.vars
.dev.vars.*

# Generated display derivatives. These are written from preserved sources by
# `npm run build:derivatives` (wired into build:site), so they are reproducible
# output rather than archive evidence and stay out of history. The preserved
# sources beside them — the .mov clips, the .gif, the Atlas sprite sheet — are
# tracked, and their published SHA-256 records remain the authority.
# Listed explicitly: source .mp4 under assets/social/ must stay tracked.
/src/assets/atlas/atlas-archive-docent-cell-01.webp
/src/assets/initial-photos/*.mp4
/src/assets/reference/**/*-timelapse-*.mp4
/src/assets/reference/**/*-timelapse-*.webm

# Nested independent git repo (SCADUMEN/ATLAS clone) — not tracked by this repo
atlas/
atlas.stray-backup-*/
