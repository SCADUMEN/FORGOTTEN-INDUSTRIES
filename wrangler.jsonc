{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forgotten-industries",
  // Pinned so local wrangler commands reach this account even when the login
  // can see several. CI sets the same ID through CLOUDFLARE_ACCOUNT_ID.
  "account_id": "f6ea8d308195655d2149be349d7bc4e0",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": true,
  "main": "src/worker/index.js",
  "routes": [
    {
      "pattern": "forgotten-industries.net",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Per-IP and site-wide submission ceilings for the public sighting intake.
  // The platform limiter keeps no record of the client it counts, so the
  // archive never stores a visitor's address to enforce them.
  "ratelimits": [
    {
      "name": "SIGHTING_LIMIT_IP",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "SIGHTING_LIMIT_GLOBAL",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgotten-industries",
      "database_id": "0ba6a720-90a4-4de9-85b6-e454be150e04",
      // Schema lives in numbered migrations, tracked per database in the
      // d1_migrations table. See src/docs/d1-database-generalization.md.
      "migrations_dir": "src/worker/migrations",
    },
  ],
}
