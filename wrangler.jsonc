{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forgotten-industries",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": true,
  "main": "src/worker/index.js",
  "routes": [
    {
      "pattern": "forgotten-industries.net",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jjammocan-sightings",
      "database_id": "e909c0a4-b968-4b56-b673-b6351c3eef62",
    },
  ],
}
